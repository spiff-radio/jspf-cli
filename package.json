{
  "name": "jspf-cli",
  "version": "2.0.8",
  "description": "JSPF CLI is a command line utility (CLI) relying on the JSPF format to convert and validate playlist files.",
  "keywords": [
    "playlist",
    "jspf",
    "json",
    "xspf",
    "m3u8",
    "m3u",
    "pls",
    "convert",
    "convertor",
    "conversion",
    "parse",
    "parser",
    "parsing",
    "validate",
    "validation"
  ],
  "author": {
    "name": "Spiff Radio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spiff-radio/jspf-cli.git"
  },
  "bugs": {
    "url": "https://github.com/spiff-radio/jspf-cli/issues"
  },
  "homepage": "https://github.com/spiff-radio/jspf-cli#readme",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "main": "./build/cli/index.js",
  "types": "./build/cli/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/cli/index.d.ts",
      "default": "./build/cli/index.js"
    },
    "./lib": {
      "types": "./build/convert/index.d.ts",
      "default": "./build/convert/index.js"
    },
    "./lib/*": {
      "types": "./build/convert/*.d.ts",
      "default": "./build/convert/*.js"
    },
    "./build/entities/models.js": {
      "types": "./build/entities/models.d.ts",
      "default": "./build/entities/models.js"
    }
  },
  "bin": {
    "jspf-cli": "build/cli/index.js"
  },
  "scripts": {
    "prepare": "npm run build",
    "start": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/cli/index.ts",
    "start:windows": "nodemon --watch 'src/**/*.ts' --exec \"npx ts-node\" src/cli/index.ts",
    "create": "npm run build && npm run test",
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p .",
    "test": "vitest run  --reporter verbose",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "install-local": "npm i -g && jspf-cli",
    "uninstall-local": "npm uninstall -g && jspf-cli",
    "refresh": "rm -rf ./node_modules ./package-lock.json && npm install"
  },
  "dependencies": {
    "clean-deep": "^3.4.0",
    "figlet": "^1.9.4",
    "jsesc": "^3.1.0",
    "m3u8-parser": "^7.2.0",
    "xml-js": "^1.6.11",
    "yargs": "^18.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/jsesc": "^3.0.3",
    "@types/node": "^24.10.1",
    "@types/yargs": "^17.0.35",
    "@vitest/ui": "^4.0.10",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10"
  }
}
